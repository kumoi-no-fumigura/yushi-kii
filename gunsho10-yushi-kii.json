 "poems": [
  {
   "seq": "1",
   "text": "朝まき霞なこめそ山櫻たつれ行まのよそめにもみむ",
   "kana": "",
   "speaker": "〔舊本行書躰〕",
   "page": 174,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "聞てしも猶そまたるゝ郭公なく一こゑにあかめ心は",
   "kana": "",
   "speaker": "",
   "page": 174,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "鏡山みねよりいつる月なれは曇る夜もなきかけをこそみれ",
   "kana": "",
   "speaker": "",
   "page": 174,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "おとに聞あきの湊は風にちるもみちの舟のわたり也けり",
   "kana": "",
   "speaker": "",
   "page": 174,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "人ゑれぬ思ひありその浦風に浪のよるこそいはまほしけれ",
   "kana": "",
   "speaker": "",
   "page": 174,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "音にきくたかしの濵のあた浪はかけしや袖のぬれもこそすれ",
   "kana": "",
   "speaker": "",
   "page": 174,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "袖のうへの露けかりつるこよひかなこれや秋立初なるらむ",
   "kana": "",
   "speaker": "",
   "page": 174,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "人ゑれす思ひそめてし山河のいはまの水をもらしつるかな",
   "kana": "",
   "speaker": "",
   "page": 174,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "かひなしや岩まの水をもらしてもすむへき〓との此世ならねは",
   "kana": "",
   "speaker": "",
   "page": 174,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "あふ〓とのかくてたえなは哀我よゝのほたしと成ぬへき身そ",
   "kana": "",
   "speaker": "",
   "page": 174,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "なとやかくはかなき夢を後よのほたしと迄は思ひたとるそ",
   "kana": "",
   "speaker": "",
   "page": 174,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "千早振あら人かみに事よせつけふの葵をかさゝさらめや",
   "kana": "",
   "speaker": "",
   "page": 174,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "もろかつらかた〓〓かくる心をは哀ともみしかものみつかき",
   "kana": "",
   "speaker": "",
   "page": 174,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "郭公行へもしらぬ一聲にこゝろそらなる五月やみかな",
   "kana": "",
   "speaker": "",
   "page": 174,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "かへるさは篝もかけし藻かり舟澤の螢ひましなけれは",
   "kana": "",
   "speaker": "",
   "page": 174,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "わか戀はあまの原なる月なれやくるれはいつる影をのみみる",
   "kana": "",
   "speaker": "",
   "page": 174,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "ふりはへてとはん物とは思はねと耳のみとまる鈴鹿山かな",
   "kana": "",
   "speaker": "",
   "page": 174,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "つれよりも萩のあさ露しけきかなこれやわかれの涙なるらん",
   "kana": "",
   "speaker": "",
   "page": 174,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "あた浪を君こそこさめ年ふとも我まつ山は色もかはらし",
   "kana": "",
   "speaker": "",
   "page": 174,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "いにしへの月まつ里をみるにこそ哀うき世はたくひ有けれ",
   "kana": "",
   "speaker": "",
   "page": 174,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "恨むなよ影見えかたき夕つくよおほろけならぬ雲間待身そ",
   "kana": "",
   "speaker": "",
   "page": 174,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "なにとてか心にかゝりそめにけん神のゆるさぬ中のあふひを",
   "kana": "",
   "speaker": "",
   "page": 174,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "神な月あさひの山もうち時雨いまや紅葉の錦おるらむ",
   "kana": "",
   "speaker": "",
   "page": 174,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "きみゝねはあさ日の山ももみち葉もよるの錦の心ちせしかな",
   "kana": "",
   "speaker": "",
   "page": 174,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "もろともに君もはかなくきえにけり埋火いかて煙たてけん",
   "kana": "",
   "speaker": "",
   "page": 174,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "かけていへは驚かされて埋火のきえにし事はきえでかなしき",
   "kana": "",
   "speaker": "",
   "page": 174,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "里なれぬ山ほとゝきすかたらふに都の人のなとかおとせぬ",
   "kana": "",
   "speaker": "",
   "page": 174,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "都にはいかはかりかはまちわふる山時鳥かたらひし音を",
   "kana": "",
   "speaker": "",
   "page": 174,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "あき霧のたちゐにつけて待しかとあふみの海の心せしかな",
   "kana": "",
   "speaker": "",
   "page": 174,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "秋かせにふけの里人音すやとわれも心にかゝる川なみ",
   "kana": "",
   "speaker": "",
   "page": 174,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "にこりなき泉にやさる月をみてすむらん人の心をそくむ",
   "kana": "",
   "speaker": "",
   "page": 174,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "箸鷹のすゝろにかゝる住居してのへの雉子と音をのみそなく",
   "kana": "",
   "speaker": "",
   "page": 174,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "鶯もみやこの人をこふとてやふかき山へに我ことは鳴",
   "kana": "",
   "speaker": "",
   "page": 174,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "霞わけ思ひこそやれ鶯のはね打かはす花のねくらを",
   "kana": "",
   "speaker": "",
   "page": 174,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "心からひまもなきまて靑つゝらくる〓〓物を思ふころかな",
   "kana": "",
   "speaker": "",
   "page": 174,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "山ふかみくる道もなきあをつゝらなにとて人の尋ねそむらん",
   "kana": "",
   "speaker": "",
   "page": 174,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "そらすみて棚引雲もなき夜半は半の月を思ひこそやれ",
   "kana": "",
   "speaker": "",
   "page": 174,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "思ひ出る半の月をみてしよりほのかにきゝしとはこひしき",
   "kana": "",
   "speaker": "",
   "page": 174,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "春たつときくにつけても春日野のわかなをなとか人の忘るゝ",
   "kana": "",
   "speaker": "",
   "page": 174,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "かきつむる藻鹽の煙立かへり靡きなひかすきくよしもかな",
   "kana": "",
   "speaker": "",
   "page": 174,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "わりなしや藻鹽の煙ひと方に靡きもえこそやられさりけり",
   "kana": "",
   "speaker": "",
   "page": 174,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "戀しさにたふる煙のあらはこそ哀をかくる折もまちみめ",
   "kana": "",
   "speaker": "",
   "page": 174,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "難波江の芦間分ゆくみなれさをみなれし人のこひらるゝ哉",
   "kana": "",
   "speaker": "",
   "page": 174,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "せきれたる心每にもみゆる哉おとわの河の流ならねと",
   "kana": "",
   "speaker": "",
   "page": 174,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "月影もせきの〓水にすめるよはさやかにみゆる駒のかけかな",
   "kana": "",
   "speaker": "",
   "page": 174,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "46",
   "text": "我ならぬ人きくらめや珍らしきあしたのはらの鶯のこゑ",
   "kana": "",
   "speaker": "祐子内親王家紀伊集",
   "page": 175,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "47",
   "text": "越ぬより思ひこそやれみちのくの名に流れたるふら川の關",
   "kana": "",
   "speaker": "",
   "page": 175,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "48",
   "text": "舟とめてみれともあかぬ松風の波よせかくる天のはし立",
   "kana": "",
   "speaker": "",
   "page": 175,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "49",
   "text": "いくめくり過しきぬらん春秋のそむる衣をうつろはしつゝ",
   "kana": "",
   "speaker": "",
   "page": 175,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "50",
   "text": "久かたの月を遙になかむれは八十島めくり見る心ちする",
   "kana": "",
   "speaker": "",
   "page": 175,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "51",
   "text": "さそはねとかたみそ見ゆる若菜つむ心はのへに通ひけりとも",
   "kana": "",
   "speaker": "",
   "page": 175,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "52",
   "text": "賴めおきし程ふるまゝに小夜衣うらかなしかるつちの音かな",
   "kana": "",
   "speaker": "",
   "page": 175,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "53",
   "text": "まつ人はおのつからきぬ我宿の梅の匂の色しこけれは",
   "kana": "",
   "speaker": "",
   "page": 175,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "54",
   "text": "たまさかに逢て別れし人よりもまさりてをしき秋の暮かな",
   "kana": "",
   "speaker": "",
   "page": 175,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "55",
   "text": "またきにそつみにきにけり遙〓といま萠出るのへの早蕨",
   "kana": "",
   "speaker": "",
   "page": 175,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "56",
   "text": "風はやみ冬のはしめは山かつの賤の松かきひまなくそゆふ",
   "kana": "",
   "speaker": "",
   "page": 175,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "57",
   "text": "たくひなくみゆるは春の明ほのに匂ふ櫻の花さかりかな",
   "kana": "",
   "speaker": "",
   "page": 175,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "58",
   "text": "をく霜は忍ひの妻にあらねともあした詫しくきえ歸るらん",
   "kana": "",
   "speaker": "",
   "page": 175,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "59",
   "text": "山ふきの花みる人や昔よりこゝを井手とはいひなかしけん",
   "kana": "",
   "speaker": "",
   "page": 175,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "60",
   "text": "かきくらし俄にもふる霰かな深山おろしの風にたくひて",
   "kana": "",
   "speaker": "",
   "page": 175,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "61",
   "text": "けふのみと空に暮行春なれはとゝむる關もかひなかりけり",
   "kana": "",
   "speaker": "",
   "page": 175,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "62",
   "text": "白雪のふりしきぬれは苔むしろ靑根かみねもみえす成行",
   "kana": "",
   "speaker": "",
   "page": 175,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "63",
   "text": "身にしみて花色ころも惜しけれとけふは單に立そかへつる",
   "kana": "",
   "speaker": "",
   "page": 175,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "64",
   "text": "うら風に吹上のはまの濵千鳥浪たちくらし夜半に鳴なり",
   "kana": "",
   "speaker": "",
   "page": 175,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "65",
   "text": "年をへて松のを山のあふひこそ色もかはらぬかさし成けれ",
   "kana": "",
   "speaker": "",
   "page": 175,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "66",
   "text": "人ゑれぬ戀にはみをもえそなげぬとゝまらんなをせめて思へは",
   "kana": "",
   "speaker": "",
   "page": 175,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "67",
   "text": "七夕のあふせのなとか稀ならんけふひくいとのたえめ物から",
   "kana": "",
   "speaker": "",
   "page": 175,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "68",
   "text": "つれなさに思ひこりすと歎しをけさは嬉しき心なりけり",
   "kana": "",
   "speaker": "",
   "page": 175,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "69",
   "text": "置露もゑつ心なく秋かせにみたれてさけるをのゝ萩はら",
   "kana": "",
   "speaker": "",
   "page": 175,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "70",
   "text": "かけろふのほのみし人の戀しさにあろにもあらす戀そけぬへき",
   "kana": "",
   "speaker": "",
   "page": 175,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "71",
   "text": "藤袴たれになれけんなつかしき香に匂ひつゝ色はふりせす",
   "kana": "",
   "speaker": "",
   "page": 175,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "72",
   "text": "おもふ〓と有明の月のあかつきに心すみます物にそ有ける",
   "kana": "",
   "speaker": "",
   "page": 175,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "73",
   "text": "秋きりの立へたてつる麓には遠かた人そうとく成ゆく",
   "kana": "",
   "speaker": "",
   "page": 175,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "74",
   "text": "打ならす人しなけれは君が代はかけしつゝみも苔おひにけり",
   "kana": "",
   "speaker": "",
   "page": 175,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "75",
   "text": "春霞みちもほのかになる儘にかへりみまさん逢坂のせき",
   "kana": "",
   "speaker": "",
   "page": 175,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "76",
   "text": "おもひやる心はかりはかよふらん霞へたつる關路なりとも",
   "kana": "",
   "speaker": "",
   "page": 175,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "77",
   "text": "旅衣うら吹かへす秋風にひとりねさめて戀しかりしを",
   "kana": "",
   "speaker": "",
   "page": 175,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "78",
   "text": "神風もかはかり身にはゑましかし片しく袖のさゆるよな〓〓",
   "kana": "",
   "speaker": "",
   "page": 175,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  }
 ],
 "catalog": {
